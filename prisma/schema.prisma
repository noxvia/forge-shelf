generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum FileKind {
  MESH // .stl .obj .step, plain .3mf — printable geometry
  PLATE // slicer project files holding an arrangement: Bambu/Prusa .3mf, .lys
  SLICED // .gcode .gcode.3mf .ctb .goo .sl1 — machine-ready
  IMAGE // renders, reference photos
  DOC // instructions, licences, readmes
  ARCHIVE // the original .zip a model came in
}

enum Technology {
  FDM
  SLA
}

enum PrinterKind {
  FDM_BAMBU // Bambu Lab, LAN mode (MQTT + FTPS)
  RESIN_SDCP // Elegoo / Anycubic ChiTu SDCP over LAN
}

enum JobStatus {
  QUEUED
  UPLOADING
  STARTING
  PRINTING
  PAUSED
  DONE
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Model {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  designer      String?
  sourceUrl     String?
  license       String?
  notes         String?
  /// Path relative to STORAGE_DIR, e.g. "thumbs/<id>.png"
  thumbnailPath String?
  favorite      Boolean  @default(false)
  printCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  files       ModelFile[]
  tags        Tag[]        @relation("ModelTags")
  collections Collection[] @relation("ModelCollections")
  jobs        PrintJob[]

  @@index([createdAt])
  @@index([favorite])
}

model ModelFile {
  id String @id @default(cuid())
  /// Null for a plate export, which spans several models.
  modelId String?
  model   Model?  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  /// Set when this file was exported from a build plate.
  plateId String?
  plate   Plate?  @relation("PlateExports", fields: [plateId], references: [id], onDelete: SetNull)

  kind     FileKind
  filename String
  /// Path relative to STORAGE_DIR
  storagePath String
  mime        String?
  sizeBytes   BigInt
  sha256      String?

  // Mesh statistics — populated for FileKind.MESH
  triangles  Int?
  bboxX      Float?
  bboxY      Float?
  bboxZ      Float?
  volumeMm3  Float?
  /// For SLICED files: which technology the output targets
  technology Technology?

  /// Adapter-specific extras: layer count, est. time, filament grams, resin ml…
  meta Json?

  createdAt DateTime @default(now())

  jobs       PrintJob[]
  plateItems PlateItem[]

  @@index([modelId])
  @@index([plateId])
  @@index([kind])
  @@index([sha256])
}

// ---------------------------------------------------------------------------
// Build plates
//
// A plate is an arrangement of meshes in printer space. Each item carries its
// own transform; those are baked into one mesh on export, ready to open in a
// desktop slicer.
// ---------------------------------------------------------------------------

model Plate {
  id    String  @id @default(cuid())
  name  String
  notes String?

  /// Which machine's build volume the layout is checked against.
  printerId String?
  printer   Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   PlateItem[]
  /// Combined meshes exported from this arrangement, ready to open in a slicer.
  exports ModelFile[] @relation("PlateExports")

  @@index([updatedAt])
}

model PlateItem {
  id      String @id @default(cuid())
  plateId String
  plate   Plate  @relation(fields: [plateId], references: [id], onDelete: Cascade)

  fileId String
  file   ModelFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  /// Millimetres in printer space; Z is the drop onto the plate.
  posX Float @default(0)
  posY Float @default(0)
  posZ Float @default(0)

  /// Degrees.
  rotX Float @default(0)
  rotY Float @default(0)
  rotZ Float @default(0)

  /// Uniform for now; per-axis can be added without touching the bake step.
  scale Float @default(1)

  createdAt DateTime @default(now())

  @@index([plateId])
}

model Tag {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique
  color  String?
  models Model[] @relation("ModelTags")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  models      Model[]  @relation("ModelCollections")
}

// ---------------------------------------------------------------------------
// Printers & jobs
// ---------------------------------------------------------------------------

model Printer {
  id   String      @id @default(cuid())
  name String
  kind PrinterKind

  host String
  port Int?
  /// Bambu: device serial (required). SDCP: mainboard id (discovered).
  serial String?
  /// AES-256-GCM ciphertext of the LAN access code. Never leaves the server.
  secretEnc String?

  modelName String?
  buildX    Float?
  buildY    Float?
  buildZ    Float?

  /// Last known coarse state: idle | printing | paused | offline | error
  status     String    @default("unknown")
  /// Full last status payload from the adapter, for the detail panel.
  statusJson Json?
  lastSeenAt DateTime?
  lastError  String?

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs   PrintJob[]
  plates Plate[]

  @@unique([kind, host])
}

model PrintJob {
  id String @id @default(cuid())

  printerId String
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  fileId String
  file   ModelFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  modelId String?
  model   Model?  @relation(fields: [modelId], references: [id], onDelete: SetNull)

  status   JobStatus @default(QUEUED)
  progress Int       @default(0)

  layerCurrent Int?
  layerTotal   Int?
  etaSeconds   Int?

  /// Filename as it exists on the printer's storage.
  remoteFilename String?
  error          String?
  log            String?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, queuedAt])
  @@index([printerId])
}
