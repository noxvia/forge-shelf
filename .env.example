# ---------------------------------------------------------------------------
# Copy to .env and edit. docker compose reads this file automatically.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=forgeshelf
# Used by the app + worker containers. Host "db" is the compose service name.
DATABASE_URL=postgresql://forge:change-me-please@db:5432/forgeshelf?schema=public

# --- App --------------------------------------------------------------------
# Port the web UI is published on.
APP_PORT=8770

# Which image to run. Only used by docker-compose.ghcr.yml (the pull-only
# deployment); docker-compose.yml builds from source and ignores this.
#   :latest  full image, includes the slicer toolchain (amd64 only)
#   :slim    no slicers, much smaller, also builds for arm64
# IMAGE=ghcr.io/YOUR-USERNAME/YOUR-REPO:latest

# Where uploaded models, thumbnails and slice output live *inside* the
# container. The compose file maps this to the ./data volume.
STORAGE_DIR=/data

# 32+ random bytes. Encrypts printer access codes at rest.
# Generate with:  openssl rand -hex 32
APP_SECRET=replace-with-openssl-rand-hex-32

# Max single upload in megabytes.
MAX_UPLOAD_MB=2048

# --- Tools ------------------------------------------------------------------
# Inspects sliced files for resin traps, islands and suction cups. Installed
# when built with INSTALL_TOOLS=true (the default).
UVTOOLS_BIN=/opt/uvtools/usr/bin/UVtoolsCmd
PYTHON_BIN=python3
# Ceiling on a single mesh operation (export, inspect, plugin), in seconds.
MESH_TIMEOUT_SECONDS=300
# Where editing plugins are discovered. Inside the data volume, so new plugins
# need no rebuild.
PLUGINS_DIR=/data/plugins

# --- Opening files in a desktop slicer ---------------------------------------
# Where the ./data volume actually lives on the machine you browse from. The
# container only knows /data; ChiTuBox and Bambu Studio need the real path.
# Leave unset and the "open in" buttons stay hidden.
# Windows example:
# HOST_DATA_DIR=C:\Users\you\forge-shelf\data
# Linux example:
# HOST_DATA_DIR=/srv/forge-shelf/data

# --- Worker -----------------------------------------------------------------
# How often the worker polls the DB for queued jobs (ms).
WORKER_POLL_MS=3000
# How often live printer status is refreshed (ms).
PRINTER_POLL_MS=10000

# --- Printer discovery ------------------------------------------------------
# UDP broadcast address used to find resin (SDCP) printers on your LAN.
# Set to your subnet broadcast, e.g. 192.168.1.255, if 255.255.255.255 is filtered.
SDCP_BROADCAST=255.255.255.255
